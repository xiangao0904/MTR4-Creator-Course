---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RouteMap from '../components/RouteMap.astro';
import { site } from '../data/site';
import { episodes } from '../data/episodes';

const instructors = [
  { name: 'AA', role: '配置开发', photo: '/images/speakers/aa.jpg' },
  { name: 'Continuate', role: '车辆模型', photo: '/images/speakers/continueate.jpg' },
  { name: 'Souto35', role: '材质贴图', photo: '/images/speakers/souto.jpg' },
  { name: 'Vulpard', role: '社区生态 / 音效', photo: '/images/speakers/vulpard.jpg' },
  { name: 'Wjr596', role: '脚本开发', photo: '/images/speakers/wjr.jpg' },
];
---

<BaseLayout title={site.name} description={site.description}>
  <Hero />

  <section class="section surface home-skills">
    <div class="container">
      <SectionHeading kicker="Core Skills" title="你将学到什么" />
      <div class="feature-grid">
        {site.highlights.map((item, index) => (
          <article class="feature-card" data-reveal style={`--reveal-delay: ${0.06 * index}s;`}>
            <span class="feature-card-icon">
              <img src={item.icon} alt={item.iconAlt} loading="lazy" />
            </span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        kicker="Route Map"
        title="课程路线图"
        lead="从资源结构到发布维护，系统掌握 MTR 车辆资源包的完整制作流程。"
        align="center"
      />
      <RouteMap episodes={episodes} />
    </div>
  </section>

  <section class="section surface">
    <div class="container">
      <div class="instructor-head">
        <SectionHeading kicker="Instructors" title="讲者简介" />
        <p data-reveal>按字母顺序排序</p>
      </div>

      <div class="instructor-grid">
        {instructors.map((item, index) => (
          <article class="instructor-card" data-reveal style={`--reveal-delay: ${0.05 * index}s;`}>
            <div class="avatar">
              {item.photo ? (
                <img src={item.photo} alt={`${item.name} 头像`} loading="lazy" />
              ) : (
                <span>{item.name.slice(0, 1)}</span>
              )}
            </div>
            <div>
              <strong>{item.name}</strong>
              <span>{item.role}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container home-cta-section">
    <div class="home-cta" data-reveal>
      <h2>开启你的列车创作之旅</h2>
      <p>从 EP0 开始，完成你的 MTR 4.0 资源包。</p>
      <a class="btn primary" href="/courses/">立刻开始学习</a>
    </div>
  </section>
</BaseLayout>
