---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

type Props = {
  title?: string;
  description?: string;
};

const { title = site.name, description = site.description } = Astro.props;
const pageTitle = title === site.name ? title : `${title} · ${site.shortName}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1523" />
    <link rel="icon" type="image/png" sizes="128x128" href="/images/site-icon-128.png" />
    <link rel="apple-touch-icon" href="/images/site-icon-128.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
